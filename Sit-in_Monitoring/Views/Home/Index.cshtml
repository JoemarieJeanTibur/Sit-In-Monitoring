@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<!-- HERO -->
<section class="landing-hero">
    <div class="badge-pill">UC CCS Laboratory System</div>
    <h1>Track Every <span>Sit-in</span><br />Session with Ease</h1>
    <p>A streamlined monitoring system for the University of Cebu College of Computer Studies laboratory.</p>
    <div class="hero-cta">
        <a asp-action="Login" class="btn-yellow">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
        <a asp-action="Register" class="btn-outline-white">
            <i class="bi bi-person-plus me-1"></i> Create Account
        </a>
    </div>
</section>

<!-- STATS -->
<div class="stats-row">
    <div class="stat-item">
        <div class="stat-num">500+</div>
        <div class="stat-label">Active Students</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">12</div>
        <div class="stat-label">Lab Rooms</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">24/7</div>
        <div class="stat-label">Monitored</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-label">Secure</div>
    </div>
</div>

<!-- FEATURES -->
<section class="features-section">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label">What you get</div>
            <h2 class="section-title">Everything You Need</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🧑‍🎓</div>
                    <h5>Student Profiles</h5>
                    <p>View and manage your complete student information including course, year level, and contact details.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">📋</div>
                    <h5>Session History</h5>
                    <p>Keep track of all your previous sit-in sessions, total hours logged, and lab usage records.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">📜</div>
                    <h5>Lab Rules & Guidelines</h5>
                    <p>Quickly access laboratory rules and policies to ensure a smooth and compliant session every time.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- LEADERBOARD -->
<section class="landing-leaderboard" style="background: linear-gradient(135deg, rgba(61, 43, 125, 0.1) 0%, rgba(106, 79, 201, 0.05) 100%); padding: 4rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label">Recognition & Achievement</div>
            <h2 class="section-title">Student Leaderboard</h2>
            <p style="color: #888; font-size: 0.95rem; margin-top: 0.5rem;">Top performers based on sit-in hours and engagement points</p>
        </div>
        <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9f7ff; border-bottom: 2px solid #ede8ff;">
                        <th style="padding: 16px 24px; text-align: left; font-size: 0.85rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Rank</th>
                        <th style="padding: 16px 24px; text-align: left; font-size: 0.85rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Student</th>
                        <th style="padding: 16px 24px; text-align: center; font-size: 0.85rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Course</th>
                        <th style="padding: 16px 24px; text-align: center; font-size: 0.85rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Sessions</th>
                        <th style="padding: 16px 24px; text-align: center; font-size: 0.85rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Points</th>
                    </tr>
                </thead>
                <tbody id="landingLeaderboardBody">
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td colspan="5" style="padding: 40px 24px; text-align: center; color: #aaa; font-size: 0.95rem;">Loading leaderboard...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="text-align: center; margin-top: 24px;">
            <a asp-action="Leaderboard" asp-controller="Student" class="btn-yellow" style="display: inline-block; padding: 10px 28px; border-radius: 8px; text-decoration: none; font-weight: 600;">
                View Full Leaderboard →
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function loadLandingLeaderboard() {
            try {
                const response = await fetch('/Student/GetLeaderboard');
                const data = await response.json();
                const tbody = document.getElementById('landingLeaderboardBody');

                if (data.success && data.leaderboard && data.leaderboard.length > 0) {
                    tbody.innerHTML = data.leaderboard.slice(0, 5).map((entry) => `
                        <tr style="border-bottom: 1px solid #f0f0f0; transition: background 0.2s ease;">
                            <td style="padding: 16px 24px; font-weight: 700; color: #3d2b7d; font-size: 1rem;">${entry.Rank}</td>
                            <td style="padding: 16px 24px; font-size: 0.95rem;">
                                <strong>${entry.FirstName} ${entry.LastName}</strong>
                                <div style="font-size: 0.8rem; color: #aaa;">${entry.IDNumber}</div>
                            </td>
                            <td style="padding: 16px 24px; text-align: center; font-size: 0.9rem; color: #666;">${entry.Course} — ${entry.YearLevel}</td>
                            <td style="padding: 16px 24px; text-align: center; font-weight: 600; color: #58A6FF; font-size: 0.95rem;">${entry.SessionsUsed}</td>
                            <td style="padding: 16px 24px; text-align: center; font-weight: 700; color: #F5C542; font-size: 1.1rem;">${entry.Points} ⭐</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <td colspan="5" style="padding: 40px 24px; text-align: center; color: #aaa; font-size: 0.95rem;">No leaderboard data yet. Leaderboard will appear as students start logging sit-in sessions.</td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error('Error loading leaderboard:', error);
                document.getElementById('landingLeaderboardBody').innerHTML = '<tr style="border-bottom: 1px solid #f0f0f0;"><td colspan="5" style="padding: 40px 24px; text-align: center; color: #aaa; font-size: 0.95rem;">Leaderboard temporarily unavailable.</td></tr>';
            }
        }

        document.addEventListener('DOMContentLoaded', loadLandingLeaderboard);
    </script>
}