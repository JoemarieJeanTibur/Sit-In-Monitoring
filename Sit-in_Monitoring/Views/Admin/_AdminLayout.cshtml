<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | Sit-in Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg admin-navbar position-relative">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard">
                    Sit-in Monitor
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNav">

                    <!-- Center nav links -->
                    <ul class="navbar-nav mx-auto d-flex flex-row gap-1">
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="showSection('home')">Home</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="showSection('leaderboard')">Leaderboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="showSection('search')">Search</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="showSection('students')">Student List</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" onclick="showSection('sitin')">Sit-in</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" onclick="showSection('records'); return false;">
                                Sit-in Records
                            </a>
                            <ul class="dropdown-menu admin-dropdown">
            
                                <li><a class="dropdown-item" href="#" onclick="showSection('sitinreports')"><i class="bi bi-file-bar-graph me-2"></i>Sit-in Reports</a></li>
                                <li><a class="dropdown-item" href="#" onclick="showSection('feedback')"><i class="bi bi-chat-left-text me-2"></i>Feedback Reports</a></li>
                                <li><a class="dropdown-item" href="#" onclick="showSection('reservation')"><i class="bi bi-calendar-plus me-2"></i>Reservation</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="#" onclick="showSection('generate')"><i class="bi bi-printer me-2"></i>Generate Reports</a></li>
                                <li><a class="dropdown-item" href="#" onclick="showSection('labmanagement')"><i class="bi bi-tools me-2"></i>Lab Management</a></li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Right: Logout -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <form asp-controller="Home" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn btn-link border-0">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="pb-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Sit-in Monitoring &mdash; Admin Panel
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>