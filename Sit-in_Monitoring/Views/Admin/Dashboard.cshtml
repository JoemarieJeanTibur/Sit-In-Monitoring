async function loadAdminAnnouncements() {
    const container = document.getElementById('announcementsListContainer');
    try {
        const res = await fetch('/Admin/GetAnnouncements');
        const data = await res.json();
        if (data.success && data.announcements && data.announcements.length > 0) {
         container.innerHTML = `
            <div style="font-size:1.05rem;font-weight:800;color:#3d2b7d;padding:10px 0 14px 0;border-bottom:2px solid #3d2b7d;margin-bottom:4px;">
                Posted Announcement
            </div>` +
        data.announcements.map(a => `
            <div id="ann-item-${a.id}" style="padding:12px 0;border-bottom:1px solid #e0e0e0;">
                <div style="font-size:0.8rem;font-weight:700;color:#444;margin-bottom:6px;">
                    CCS Admin | ${a.createdAt}
                    <button onclick="deleteAnnouncement(${a.id})" style="float:right;background:none;border:none;color:#c0392b;cursor:pointer;font-size:0.75rem;padding:0;font-weight:600;">🗑 Delete</button>
                </div>
                <div style="font-size:0.82rem;font-weight:700;color:#222;margin-bottom:3px;">${a.title}</div>
                <div style="font-size:0.82rem;color:#555;line-height:1.5;">${a.content}</div>
            </div>
        `).join('');
        } else {
            container.innerHTML = '<div style="text-align:center;color:#aaa;padding:30px 0;font-size:0.9rem;">No announcements yet.</div>';
        }
    } catch(e) {
        container.innerHTML = '<div style="color:#c0392b;padding:10px;">Failed to load announcements.</div>';
    }
}

async function submitAnnouncement(e) {
    e.preventDefault();
    const title = document.getElementById('ann_title').value.trim();
    const content = document.getElementById('ann_content').value.trim();
    const token = document.querySelector('#announcementForm_form input[name="__RequestVerificationToken"]').value;
    const feedback = document.getElementById('ann_feedback');
    feedback.textContent = 'Posting...';
    feedback.style.color = '#888';
    try {
        const res = await fetch('/Admin/CreateAnnouncement', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `Title=${encodeURIComponent(title)}&Content=${encodeURIComponent(content)}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
        const data = await res.json();
        if (data.success) {
            feedback.textContent = '✅ ' + data.message;
            feedback.style.color = '#1a7a3a';
            document.getElementById('ann_title').value = '';
            document.getElementById('ann_content').value = '';
            setTimeout(() => {
                document.getElementById('announcementForm').style.display = 'none';
                feedback.textContent = '';
                loadAdminAnnouncements();
            }, 1000);
        } else {
            feedback.textContent = '❌ ' + data.message;
            feedback.style.color = '#c0392b';
        }
    } catch(e) {
        feedback.textContent = '❌ Error posting announcement.';
        feedback.style.color = '#c0392b';
    }
}

async function deleteAnnouncement(id) {
    if (!confirm('Delete this announcement?')) return;
    const token = document.querySelector('input[name="__RequestVerificationToken"]');
    try {
        const res = await fetch('/Admin/DeleteAnnouncement', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}` + (token ? `&__RequestVerificationToken=${encodeURIComponent(token.value)}` : '')
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById('ann-item-' + id)?.remove();
            const container = document.getElementById('announcementsListContainer');
            if (!container.querySelector('.announcement-item')) {
                container.innerHTML = '<div style="text-align:center;color:#aaa;padding:30px 0;font-size:0.9rem;">No announcements yet.</div>';
            }
        }
    } catch(e) {}
}

