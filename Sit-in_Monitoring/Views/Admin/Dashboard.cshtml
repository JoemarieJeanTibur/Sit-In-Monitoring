    <script>
    (function () {
        var TOTAL = 50;
        var labs = ['524','526','528','530','542','544'];
        var state = {};
        labs.forEach(function(l) { state[l] = Array(TOTAL).fill(true); });

        var cur = '524';
        var sel = new Set();
        var pendingPcIdx = null;

        function render() {
            var grid = document.getElementById('lmPcGrid');
            grid.innerHTML = '';
            sel.clear();
            state[cur].forEach(function(avail, i) {
                var el = document.createElement('div');
                el.className = 'lm-pc' + (avail ? '' : ' lm-unavail');
                el.dataset.i = i;
                el.innerHTML =
                    '<div class="lm-pc-num">PC ' + (i + 1) + '</div>' +
                    '<div class="lm-pc-lbl">' + (avail ? 'Available' : 'Unavailable') + '</div>';
                el.onclick = function() {
                    var isAvail = state[cur][i];
                    pendingPcIdx = i;

                    var iconWrap = document.getElementById('lmPopupIconWrap');
                    var icon = document.getElementById('lmPopupIcon');
                    var confirmBtn = document.getElementById('lmPopupConfirmBtn');

                    if (isAvail) {
                        iconWrap.style.background = '#fff5f5';
                        iconWrap.style.border = '2px solid #e03131';
                        icon.className = 'bi bi-x-circle';
                        icon.style.color = '#a32d2d';
                        confirmBtn.style.background = '#a32d2d';
                        document.getElementById('lmPopupMsg').textContent = 'Mark PC ' + (i + 1) + ' as unavailable?';
                    } else {
                        iconWrap.style.background = '#f6fff8';
                        iconWrap.style.border = '2px solid #2f7a3b';
                        icon.className = 'bi bi-check-circle';
                        icon.style.color = '#2f7a3b';
                        confirmBtn.style.background = '#2f7a3b';
                        document.getElementById('lmPopupMsg').textContent = 'Mark PC ' + (i + 1) + ' as available?';
                    }

                    document.getElementById('lmPopupTitle').textContent = 'PC ' + (i + 1) + ' — Lab ' + cur;
                    document.getElementById('lmPopup').style.display = 'flex';
                };
                grid.appendChild(el);
            });
            updateCounters();
        }

        function updateCounters() {
            var a = state[cur].filter(Boolean).length;
            document.getElementById('lmTotal').textContent = TOTAL;
            document.getElementById('lmAvail').textContent = a;
            document.getElementById('lmUnavail').textContent = TOTAL - a;
        }

        window.lmPopupConfirm = function() {
            if (pendingPcIdx !== null) {
                state[cur][pendingPcIdx] = !state[cur][pendingPcIdx];
                pendingPcIdx = null;
            }
            document.getElementById('lmPopup').style.display = 'none';
            render();
        };

        window.lmPopupClose = function() {
            pendingPcIdx = null;
            document.getElementById('lmPopup').style.display = 'none';
        };

        window.lmSwitchLab = function(lab, btn) {
            cur = lab;
            document.querySelectorAll('.lm-lab-pill').forEach(function(b) {
                b.classList.remove('lm-active');
            });
            btn.classList.add('lm-active');
            document.getElementById('lmGridTitle').textContent = 'Lab ' + lab + ' — PC Availability';
            render();
        };

        window.lmMark = function(avail) {
            if (sel.size === 0) {
                state[cur] = Array(TOTAL).fill(avail);
            } else {
                sel.forEach(function(i) { state[cur][i] = avail; });
            }
            render();
        };

        render();
    })();
    </script>
</div>


