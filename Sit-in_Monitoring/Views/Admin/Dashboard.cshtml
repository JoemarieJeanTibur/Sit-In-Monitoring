}

async function registerSitin() {
    const idNumber = document.getElementById('reg_idnumber').value.trim();
    const purpose = document.getElementById('reg_purpose').value.trim();
    const lab = document.getElementById('reg_lab').value.trim();
    const alertDiv = document.getElementById('sitinAlert');

    // Validation
    if (!idNumber || !purpose || !lab) {
        showAlert('Please fill in all fields', 'error', alertDiv);
        console.warn('Validation failed:', { idNumber, purpose, lab });
        return;
    }

    console.log('Attempting to register sit-in:', { idNumber, purpose, lab });

    try {
        const response = await fetch('/Admin/RegisterSitin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `IdNumber=${encodeURIComponent(idNumber)}&Purpose=${encodeURIComponent(purpose)}&Lab=${encodeURIComponent(lab)}`
        });

        console.log('Response status:', response.status);
        const data = await response.json();
        console.log('Response data:', data);

        if (data.success) {
            showAlert('✅ ' + data.message + ' (Sessions left: ' + data.sessionsRemaining + ')', 'success', alertDiv);
            console.log('Registration successful');

            // Update local student data
            const studentIdx = allStudents.findIndex(s => s.idNumber === idNumber);
            if (studentIdx !== -1) {
                allStudents[studentIdx].sessionsRemaining = data.sessionsRemaining;
            }

            // Show success modal
            showSuccessNotification(idNumber, purpose, lab);

            clearSitinForm();
            // Reload current sit-ins and switch view after a short delay
            setTimeout(() => {
                loadCurrentSitins();
                showSection('sitinreports');
                // Optional: refresh student list table if visible
            }, 2000);
        } else {
            showAlert('❌ ' + data.message, 'error', alertDiv);
            console.error('Registration failed:', data.message);
        }
    } catch (error) {
        showAlert('❌ Error registering sit-in. Please try again.', 'error', alertDiv);
        console.error('Error registering sit-in:', error);
    }
}

function showAlert(message, type, element) {
    element.textContent = message;
    element.style.display = 'block';
    if (type === 'success') {
        element.style.background = '#d4edda';
        element.style.color = '#155724';
        element.style.border = '1px solid #c3e6cb';
    } else {
        element.style.background = '#f8d7da';
        element.style.color = '#721c24';
        element.style.border = '1px solid #f5c6cb';
    }
}

function showSuccessNotification(idNumber, purpose, lab) {
    console.log('Showing success notification for:', { idNumber, purpose, lab });

    // Update notification details
    document.getElementById('successDetailId').textContent = idNumber;
    document.getElementById('successDetailPurpose').textContent = purpose;
    document.getElementById('successDetailLab').textContent = 'Lab ' + lab;

    // Show overlay
    const overlay = document.getElementById('successNotificationOverlay');
    overlay.classList.add('show');

    // Auto-hide after 3 seconds
    setTimeout(() => {
        overlay.classList.remove('show');
    }, 3000);
}

async function loadCurrentSitins() {
    try {
        const res = await fetch('/Admin/GetCurrentSitins');
        const data = await res.json();
        console.log('Current sit-ins loaded:', data);

        if (data.success) {
            const tbody = document.getElementById('currentSitinBody');
            if (!data.sitins || data.sitins.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#aaa;">No active sit-ins</td></tr>';
                return;
            }

            tbody.innerHTML = data.sitins.map(s => `
                <tr>
                    <td>${s.idNumber}</td>
                    <td>${s.name}</td>
                    <td>Lab ${s.lab}</td>
                    <td>${s.purpose}</td>
                    <td>${s.timeIn}</td>
                    <td><span style="background:#fff3cd;color:#856404;padding:3px 10px;border-radius:20px;font-size:0.78rem;font-weight:600;">Active</span></td>
                    <td><button class="btn-end" style="padding:5px 10px;font-size:0.75rem;" onclick="endSitin(${s.id})">End Session</button></td>
                </tr>
            `).join('');
        }
    } catch (e) {
        console.error('Error loading current sit-ins:', e);
    }
}

async function endSitin(id) {
    if (!confirm('End this sit-in session?')) return;

    try {
        const res = await fetch('/Admin/EndSitin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}`
        });

        const data = await res.json();
        console.log('End sit-in response:', data);

        if (data.success) {
            alert('✅ ' + data.message);
            loadCurrentSitins();
            loadSitinLogs();

            // Show reward option modal
            setTimeout(() => {
                showRewardModal(data.sitinId);
            }, 500);
        } else {
            alert('❌ ' + data.message);
        }
    } catch (e) {
        console.error('Error ending sit-in:', e);
        alert('Error ending sit-in session.');
    }
}

function showRewardModal(sitinId) {
    const overlay = document.createElement('div');
    overlay.id = 'rewardModalOverlay';
    overlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
    `;

    const modal = document.createElement('div');
    modal.style.cssText = `
        background: white;
        border-radius: 12px;
        padding: 32px;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    `;

    modal.innerHTML = `
        <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #F5C542, #FFD700); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 32px;">⭐</div>
        <h3 style="margin: 0 0 8px; font-size: 1.3rem; font-weight: 700; color: #3d2b7d;">Award Point?</h3>
        <p style="margin: 0 0 24px; font-size: 0.95rem; color: #666;">Would you like to give this student 1 reward point for their sit-in session?</p>
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button onclick="grantReward(${sitinId})" style="padding: 10px 24px; border-radius: 8px; border: none; background: linear-gradient(135deg, #3d2b7d, #6a4fc9); color: white; font-weight: 700; cursor: pointer; font-size: 0.9rem;">Give Point</button>
            <button onclick="closeRewardModal()" style="padding: 10px 24px; border-radius: 8px; border: 1.5px solid #ccc; background: #f5f5f5; color: #333; font-weight: 700; cursor: pointer; font-size: 0.9rem;">Skip</button>
        </div>
    `;

    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    overlay.onclick = function(e) {
        if (e.target === overlay) closeRewardModal();
    };
}

function closeRewardModal() {
    const overlay = document.getElementById('rewardModalOverlay');
    if (overlay) overlay.remove();
}

async function grantReward(sitinId) {
    try {
        const res = await fetch('/Admin/AddReward', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `sitinId=${sitinId}`
        });

        const data = await res.json();

        if (data.success) {
            closeRewardModal();
            alert('✅ ' + data.message);
            loadCurrentSitins();
        } else {
            alert('❌ ' + data.message);
        }
    } catch (e) {
        console.error('Error granting reward:', e);
        alert('Error granting reward.');
    }
}

async function loadAdminLeaderboard() {
    try {
        const res = await fetch('/Admin/GetLeaderboard');
        const data = await res.json();

        if (data.success && data.leaderboard && data.leaderboard.length > 0) {
            const tbody = document.getElementById('leaderboardBody');
            tbody.innerHTML = data.leaderboard.map((entry, index) => `
                <tr>
                    <td><strong>${entry.rank}</strong></td>
                    <td>${entry.name}</td>
                    <td>${entry.idNumber}</td>
                    <td>${entry.course} - ${entry.yearLevel}</td>
                    <td><strong>${entry.sessions}</strong></td>
                    <td><span style="color: #F5C542; font-weight: 700; font-size: 1.1rem;">${entry.points} ⭐</span></td>
                </tr>
            `).join('');
        } else {
            document.getElementById('leaderboardBody').innerHTML = 
                '<tr><td colspan="6" style="text-align:center;color:#aaa;padding:30px;">No leaderboard data yet. Students need to complete sit-in sessions.</td></tr>';
        }
    } catch (e) {
        console.error('Error loading leaderboard:', e);
        document.getElementById('leaderboardBody').innerHTML = 
            '<tr><td colspan="6" style="text-align:center;color:#c0392b;padding:20px;">Failed to load leaderboard.</td></tr>';
    }
}

    

</script>
}