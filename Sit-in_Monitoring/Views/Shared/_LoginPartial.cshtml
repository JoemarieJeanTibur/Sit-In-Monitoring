@using Microsoft.AspNetCore.Identity
@using Sit_in_Monitoring.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <ul class="navbar-nav position-absolute start-50 translate-middle-x d-flex flex-row gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="History">
                Sit-In History
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="Reservation">
               Reservation
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="Rewards">
                Rewards / Points
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="Notifications">
               Notifications
            </a>
        </li>
    </ul>
    <ul class="navbar-nav ms-auto">
        <li class="nav-item">
            <form asp-controller="Home" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link btn btn-link border-0">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav ms-auto">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Home" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Home" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i>Register
            </a>
        </li>
    </ul>
}