@model Sit_in_Monitoring.Models.User

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

@if (Model.IsCurrentlyCheckedIn)
{
    <div style="max-width:1200px;margin:1.5rem auto 0;padding:0 1rem;">
        <div class="active-sitin-banner">
            <div class="banner-content">
                <i class="bi bi-broadcast"></i>
                <span>Your account is currently active in a sit-in session.</span>
            </div>
            <a href="@Url.Action("History", "Student")" class="btn-banner">View Details</a>
        </div>
    </div>
}

<div class="dashboard-wrapper" style="@(Model.IsCurrentlyCheckedIn ? "margin-top:0;" : "")">

    <!-- LEFT SIDEBAR -->
    <aside class="sidebar-panel">
        <div class="sidebar-header">Student Information</div>

        <div class="sidebar-avatar">
            @if (Model.ProfilePicture != null && Model.ProfilePicture.Length > 0)
            {
                <img src="@Url.Action("GetProfilePicture", "Student", new { userId = Model.Id })" alt="Profile Picture" class="avatar-circle" id="profileImg" />
            }
            else
            {
                <div class="avatar-circle">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
            }
            <button type="button" class="btn-edit-profile" onclick="openProfileModal()">Edit Profile</button>
        </div>

        <div class="sidebar-info">
            <div class="info-row">
                <span class="info-label">Name:</span>
                <span class="info-value">@Model.FirstName @Model.LastName</span>
            </div>
            <div class="info-row">
                <span class="info-label">ID:</span>
                <span class="info-value">@Model.IDNumber</span>
            </div>
            <div class="info-row">
                <span class="info-label">Course:</span>
                <span class="info-value">@Model.Course</span>
            </div>
            <div class="info-row">
                <span class="info-label">Year:</span>
                <span class="info-value">@Model.YearLevel</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email:</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">Address:</span>
                <span class="info-value">@Model.Address</span>
            </div>
            <div class="info-row">
                <span class="info-label">Session:</span>
                <span class="info-value" id="sessionsRemaining">@Model.SessionsRemaining</span>
            </div>
        </div>

        <form asp-controller="Home" asp-action="Logout" method="post" class="mt-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">Logout</button>
        </form>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <div class="main-content">

        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-box-icon"><i class="bi bi-journal-text"></i></div>
                <div>
                    <div class="stat-box-num">@Model.SessionsUsed</div>
                    <div class="stat-box-label">Sessions Used</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon yellow"><i class="bi bi-calendar-check"></i></div>
                <div>
                    <div class="stat-box-num">0</div>
                    <div class="stat-box-label">Reservations</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon gold"><i class="bi bi-trophy"></i></div>
                <div>
                    <div class="stat-box-num">@Model.Points</div>
                    <div class="stat-box-label">Points</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon pink"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="stat-box-num">@Model.SessionsRemaining</div>
                    <div class="stat-box-label">Sessions Left</div>
                </div>
            </div>
            </div>

        <!-- Leaderboard Widget -->
        <div class="content-card mt-3">
            <div class="content-card-header">
                <i class="bi bi-trophy" style="color: #F5C542; margin-right: 8px;"></i>Top Students Leaderboard
                <a href="@Url.Action("Leaderboard", "Student")" style="float: right; font-size: 0.85rem; color: #5B21B6; text-decoration: none; font-weight: 600;">View Full →</a>
            </div>
            <div class="content-card-body" style="padding: 0;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f5f2ff; border-bottom: 2px solid #e0d9f7;">
                            <th style="padding: 12px 16px; text-align: left; font-size: 0.8rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">#</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 0.8rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Student</th>
                            <th style="padding: 12px 16px; text-align: center; font-size: 0.8rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Sessions</th>
                            <th style="padding: 12px 16px; text-align: center; font-size: 0.8rem; font-weight: 700; color: #3d2b7d; text-transform: uppercase; letter-spacing: 0.05em;">Points</th>
                        </tr>
                    </thead>
                    <tbody id="dashboardLeaderboardBody">
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <td colspan="4" style="padding: 20px; text-align: center; color: #aaa; font-size: 0.9rem;">Loading leaderboard...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Lab Rules -->
        <div class="content-card mt-3">
            <div class="content-card-header">Lab Rules &amp; Regulations</div>
            <div class="content-card-body rules-body">
                <h3>UNIVERSITY OF CEBU – MAIN CAMPUS</h3>
                <h4>LABORATORY RULES AND REGULATIONS</h4>
                <p class="rules-intro">To avoid embarrassment and maintain camaraderie inside the computer laboratory, the following rules and regulations are to be strictly observed:</p>
                <p>1. Maintain silence, proper decorum, and discipline inside the laboratory.</p>
                <p>2. Games are strictly prohibited inside the lab.</p>
                <p>3. Surfing the internet is allowed only with the permission of the instructor.</p>
                <p>4. Eating and drinking are not allowed inside the lab.</p>
                <p>5. Observe cleanliness and orderliness at all times.</p>
                <p>6. Absence of laboratory gown is not allowed.</p>
                <p>7. Students are required to log in and log out upon entering and leaving the laboratory.</p>
                <p>8. Students must bring their own laboratory materials.</p>
                <p>9. No vandalism of any kind is allowed.</p>
                <p>10. Students are held responsible for any damage to the equipment.</p>
            </div>
        </div>

    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:15px; overflow:hidden; border:none; box-shadow:0 10px 40px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background:#5B21B6; color:white; border-bottom:none; padding:20px 25px;">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-gear me-2"></i>Edit Your Profile</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:25px;">
                <form id="profileUpdateForm">
                    @Html.AntiForgeryToken()
                    
                    <div class="text-center mb-4">
                        <div class="position-relative d-inline-block">
                            <img src="@Url.Action("GetProfilePicture", "Student", new { userId = Model.Id })"
                                 id="modalPreview" alt="Profile"
                                 style="width:110px; height:110px; border-radius:50%; object-fit:cover; border:4px solid #f0f0f0; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
                            <label for="profilePicInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                                   style="width:34px; height:34px; cursor:pointer; background:#5B21B6 !important; border:2px solid white;">
                                <i class="bi bi-camera-fill" style="font-size:0.95rem;"></i>
                            </label>
                            <input type="file" id="profilePicInput" accept="image/*" style="display:none;" onchange="previewImage(event)">
                        </div>
                        <p class="text-muted mt-2 mb-0" style="font-size:0.75rem;">Click camera icon to change photo</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.05em; color:#888;">First Name</label>
                            <input type="text" id="edit_firstName" class="form-control" value="@Model.FirstName" required style="border-radius:8px; padding:10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.05em; color:#888;">Last Name</label>
                            <input type="text" id="edit_lastName" class="form-control" value="@Model.LastName" required style="border-radius:8px; padding:10px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.05em; color:#888;">Home Address</label>
                            <input type="text" id="edit_address" class="form-control" value="@Model.Address" required style="border-radius:8px; padding:10px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.05em; color:#888;">Course</label>
                            <select id="edit_course" class="form-select" style="border-radius:8px; padding:10px;">
                                <option value="BSIT" selected="@(Model.Course == "BSIT")">BSIT</option>
                                <option value="BSCS" selected="@(Model.Course == "BSCS")">BSCS</option>
                                <option value="BSIS" selected="@(Model.Course == "BSIS")">BSIS</option>
                                <option value="ACT" selected="@(Model.Course == "ACT")">ACT</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.05em; color:#888;">Year Level</label>
                            <select id="edit_yearLevel" class="form-select" style="border-radius:8px; padding:10px;">
                                <option value="1st Year" selected="@(Model.YearLevel == "1st Year")">1st Year</option>
                                <option value="2nd Year" selected="@(Model.YearLevel == "2nd Year")">2nd Year</option>
                                <option value="3rd Year" selected="@(Model.YearLevel == "3rd Year")">3rd Year</option>
                                <option value="4th Year" selected="@(Model.YearLevel == "4th Year")">4th Year</option>
                            </select>
                        </div>
                    </div>
                    
                    <div id="profileUpdateFeedback" class="mt-4 text-center small fw-bold"></div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f0f0f0; padding:15px 25px 25px;">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px; padding:10px 20px; font-weight:600; color:#666;">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveProfileBtn" onclick="saveProfile()" style="background:#5B21B6; border:none; border-radius:8px; padding:10px 30px; font-weight:600; box-shadow:0 4px 12px rgba(91,33,182,0.3);">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openProfileModal() {
            new bootstrap.Modal(document.getElementById('profileModal')).show();
        }

        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function() {
                document.getElementById('modalPreview').src = reader.result;
            }
            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }

        async function saveProfile() {
            const btn = document.getElementById('saveProfileBtn');
            const feedback = document.getElementById('profileUpdateFeedback');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
            feedback.textContent = '';

            try {
                const picInput = document.getElementById('profilePicInput');
                if (picInput.files.length > 0) {
                    const picData = new FormData();
                    picData.append('profilePicture', picInput.files[0]);
                    picData.append('__RequestVerificationToken', token);
                    await fetch('/Student/UploadProfilePicture', { method: 'POST', body: picData });
                }

                const details = new URLSearchParams();
                details.append('firstName', document.getElementById('edit_firstName').value);
                details.append('lastName', document.getElementById('edit_lastName').value);
                details.append('address', document.getElementById('edit_address').value);
                details.append('course', document.getElementById('edit_course').value);
                details.append('yearLevel', document.getElementById('edit_yearLevel').value);
                details.append('__RequestVerificationToken', token);

                const res = await fetch('/Student/UpdateProfile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: details
                });
                const data = await res.json();
                
                if (data.success) {
                    feedback.style.color = '#1a7a3a';
                    feedback.innerHTML = '<i class="bi bi-check-circle me-1"></i> Profile updated! Reloading...';
                    setTimeout(() => location.reload(), 1000);
                } else {
                    feedback.style.color = '#c0392b';
                    feedback.textContent = '❌ ' + data.message;
                    btn.disabled = false;
                    btn.textContent = 'Save Changes';
                }
            } catch(e) {
                console.error(e);
                feedback.style.color = '#c0392b';
                feedback.textContent = '❌ An error occurred. Please try again.';
                btn.disabled = false;
                btn.textContent = 'Save Changes';
            }
        }

        async function loadAnnouncements() {
            try {
                const response = await fetch('/Student/GetLatestAnnouncements?count=5');
                const data = await response.json();
                const container = document.getElementById('announcementsContainer');

                if (data.success && data.announcements && data.announcements.length > 0) {
                    container.innerHTML = data.announcements.map(announcement => `
                        <div class="announcement-item" style="padding:15px 0; border-bottom:1px solid #f5f5f5;">
                            <div style="display:flex; justify-content:space-between; align-items:start;">
                                <div style="flex:1;">
                                    <h6 style="margin:0 0 5px 0; color:#3d2b7d; font-weight:700; font-size:0.95rem;">${announcement.title}</h6>
                                    <p style="margin:0 0 8px 0; color:#555; font-size:0.88rem; line-height:1.5;">${announcement.content}</p>
                                    <small style="color:#aaa; font-size:0.75rem;"><i class="bi bi-clock me-1"></i> ${announcement.createdAt}</small>
                                </div>
                            </div>
                        </div>
                    `).join('');
                    container.lastElementChild.style.borderBottom = 'none';
                } else {
                    container.innerHTML = `
                        <div class="empty-state" style="padding:40px 0; text-align:center; color:#aaa;">
                            <i class="bi bi-megaphone" style="font-size:2rem; display:block; margin-bottom:10px;"></i>
                            <span>No announcements at this time.</span>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading announcements:', error);
                document.getElementById('announcementsContainer').innerHTML = '<div class="text-danger p-3 text-center">Failed to load announcements.</div>';
            }
        }

        document.addEventListener('DOMContentLoaded', loadAnnouncements);

        async function loadDashboardLeaderboard() {
            try {
                const response = await fetch('/Student/GetLeaderboard');
                const data = await response.json();
                const tbody = document.getElementById('dashboardLeaderboardBody');

                if (data.success && data.leaderboard && data.leaderboard.length > 0) {
                    tbody.innerHTML = data.leaderboard.slice(0, 5).map((entry, index) => `
                        <tr style="border-bottom: 1px solid #f0f0f0; transition: background 0.2s ease;">
                            <td style="padding: 12px 16px; font-weight: 700; color: #3d2b7d; font-size: 0.95rem;">${entry.Rank}</td>
                            <td style="padding: 12px 16px; font-size: 0.9rem;">
                                <strong>${entry.FirstName} ${entry.LastName}</strong>
                                <div style="font-size: 0.75rem; color: #aaa;">${entry.IDNumber}</div>
                            </td>
                            <td style="padding: 12px 16px; text-align: center; font-weight: 600; color: #3d2b7d;">${entry.SessionsUsed}</td>
                            <td style="padding: 12px 16px; text-align: center; font-weight: 700; color: #F5C542; font-size: 1rem;">${entry.Points} ⭐</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <td colspan="4" style="padding: 20px; text-align: center; color: #aaa; font-size: 0.9rem;">No leaderboard data yet.</td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error('Error loading leaderboard:', error);
                document.getElementById('dashboardLeaderboardBody').innerHTML = '<tr style="border-bottom: 1px solid #f0f0f0;"><td colspan="4" style="padding: 20px; text-align: center; color: #c0392b; font-size: 0.9rem;">Failed to load leaderboard.</td></tr>';
            }
        }

        document.addEventListener('DOMContentLoaded', loadDashboardLeaderboard);
    </script>
}