@model Sit_in_Monitoring.Models.User

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="dashboard-wrapper">

    <!-- LEFT SIDEBAR -->
    <aside class="sidebar-panel">
        <div class="sidebar-header">Student Information</div>

        <div class="sidebar-avatar">
            @if (Model.ProfilePicture != null && Model.ProfilePicture.Length > 0)
            {
                <img src="data:image/jpeg;base64,@System.Convert.ToBase64String(Model.ProfilePicture)" alt="Profile Picture" class="avatar-circle" id="profileImg" />
            }
            else
            {
                <div class="avatar-circle">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
            }
            <button type="button" class="btn-edit-profile" data-bs-toggle="modal" data-bs-target="#uploadPictureModal">Edit Profile</button>
        </div>

        <div class="sidebar-info">
            <div class="info-row">
                <span class="info-label">Name:</span>
                <span class="info-value">@Model.FirstName @Model.LastName</span>
            </div>
            <div class="info-row">
                <span class="info-label">ID:</span>
                <span class="info-value">@Model.IDNumber</span>
            </div>
            <div class="info-row">
                <span class="info-label">Course:</span>
                <span class="info-value">@Model.Course</span>
            </div>
            <div class="info-row">
                <span class="info-label">Year:</span>
                <span class="info-value">@Model.YearLevel</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email:</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">Address:</span>
                <span class="info-value">@Model.Address</span>
            </div>
            <div class="info-row">
                <span class="info-label">Session:</span>
                <span class="info-value" id="sessionsRemaining">@Model.SessionsRemaining</span>
            </div>
        </div>

        <form asp-controller="Home" asp-action="Logout" method="post" class="mt-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">Logout</button>
        </form>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <div class="main-content">

        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-box-icon"><i class="bi bi-journal-text"></i></div>
                <div>
                    <div class="stat-box-num">@Model.SessionsUsed</div>
                    <div class="stat-box-label">Sessions Used</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon yellow"><i class="bi bi-calendar-check"></i></div>
                <div>
                    <div class="stat-box-num">0</div>
                    <div class="stat-box-label">Reservations</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon gold"><i class="bi bi-trophy"></i></div>
                <div>
                    <div class="stat-box-num">—</div>
                    <div class="stat-box-label">Points</div>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-box-icon violet"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="stat-box-num" id="sessionsLeftStat">@Model.SessionsRemaining</div>
                    <div class="stat-box-label">Sessions Left</div>
                </div>
            </div>
        </div>

        <!-- Announcements -->
        <div class="content-card mt-3">
            <div class="content-card-header">Announcements</div>
            <div class="content-card-body empty-state">
                <i class="bi bi-megaphone"></i>
                <span>No announcements available.</span>
            </div>
        </div>

        <!-- Lab Rules -->
        <div class="content-card mt-3">
            <div class="content-card-header">Lab Rules &amp; Regulations</div>
            <div class="content-card-body rules-body">
                <h3>UNIVERSITY OF CEBU – MAIN CAMPUS</h3>
                <h4>LABORATORY RULES AND REGULATIONS</h4>
                <p class="rules-intro">To avoid embarrassment and maintain camaraderie inside the computer laboratory, the following rules and regulations are to be strictly observed:</p>
                <p>1. Maintain silence, proper decorum, and discipline inside the laboratory.</p>
                <p>2. Games are strictly prohibited inside the lab.</p>
                <p>3. Surfing the internet is allowed only with the permission of the instructor.</p>
                <p>4. Eating and drinking are not allowed inside the lab.</p>
                <p>5. Observe cleanliness and orderliness at all times.</p>
                <p>6. Absence of laboratory gown is not allowed.</p>
                <p>7. Students are required to log in and log out upon entering and leaving the laboratory.</p>
                <p>8. Students must bring their own laboratory materials.</p>
                <p>9. No vandalism of any kind is allowed.</p>
                <p>10. Students are held responsible for any damage to the equipment.</p>
            </div>
        </div>

    </div>
</div>

<!-- Upload Profile Picture Modal -->
<div class="modal fade" id="uploadPictureModal" tabindex="-1" aria-labelledby="uploadPictureLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadPictureLabel">
                    <i class="bi bi-image"></i> Upload Profile Picture
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="alertContainer"></div>
                <form id="uploadForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="profilePictureInput" class="form-label">Choose Image File</label>
                        <input class="form-control" type="file" id="profilePictureInput" name="profilePicture" accept="image/*" required />
                        <small class="text-muted">Allowed formats: JPG, JPEG, PNG, GIF (Max 5MB)</small>
                    </div>
                    <div id="previewContainer" class="mb-3" style="display: none;">
                        <img id="previewImage" src="" alt="Preview" style="max-width: 100%; max-height: 300px;" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="uploadBtn">
                    <i class="bi bi-cloud-upload"></i> Upload
                </button>
            </div>
        </div>
        <!-- Reservations -->
        <div class="content-card mt-3">
            <div class="content-card-header d-flex justify-content-between align-items-center">
                Reservations
                <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#reservationModal">
                    <i class="bi bi-plus-circle"></i> New
                </button>
            </div>
            <div class="content-card-body p-0">
                <table class="table table-sm mb-0" id="myReservationsTable">
                    <thead>
                        <tr>
                            <th>Lab</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Purpose</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="5" class="text-center text-muted py-3">No reservations yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Reservation Modal -->
        <div class="modal fade" id="reservationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-calendar-plus"></i> New Reservation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="reservationAlert"></div>
                        <form id="reservationForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Laboratory</label>
                                <select class="form-select" name="lab" required>
                                    <option value="">-- Select Lab --</option>
                                    <option>Lab 1</option>
                                    <option>Lab 2</option>
                                    <option>Lab 3</option>
                                    <option>Lab 4</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Date</label>
                                <input type="date" class="form-control" name="date" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Time</label>
                                <input type="time" class="form-control" name="time" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Purpose</label>
                                <textarea class="form-control" name="purpose" rows="3" required></textarea>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="submitReservationBtn">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('profilePictureInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('previewImage').src = event.target.result;
                    document.getElementById('previewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('uploadBtn').addEventListener('click', function () {
            const fileInput = document.getElementById('profilePictureInput');
            const file = fileInput.files[0];

            if (!file) {
                showAlert('Please select a file', 'warning');
                return;
            }

            const formData = new FormData(document.getElementById('uploadForm'));

            fetch('@Url.Action("UploadProfilePicture", "Student")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert(data.message, 'success');
                    setTimeout(() => { location.reload(); }, 1500);
                } else {
                    showAlert(data.message, 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('An error occurred while uploading the image.', 'danger');
            });
        });

        function showAlert(message, type) {
            const alertContainer = document.getElementById('alertContainer');
            alertContainer.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
        }

                // Load reservations
        function loadMyReservations() {
            fetch('@Url.Action("GetMyReservations", "Student")')
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;
                    const tbody = document.querySelector('#myReservationsTable tbody');
                    if (data.reservations.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No reservations yet.</td></tr>';
                        return;
                    }
                    const statusBadge = s => ({
                        Pending: '<span class="badge bg-warning text-dark">Pending</span>',
                        Approved: '<span class="badge bg-success">Approved</span>',
                        Rejected: '<span class="badge bg-danger">Rejected</span>'
                    }[s] || s);

                    tbody.innerHTML = data.reservations.map(r => `
                        <tr>
                            <td>${r.lab}</td>
                            <td>${r.date}</td>
                            <td>${r.time}</td>
                            <td>${r.purpose}</td>
                            <td>${statusBadge(r.status)}</td>
                        </tr>
                    `).join('');
                });
        }
        loadMyReservations();

        // Submit reservation
        document.getElementById('submitReservationBtn').addEventListener('click', function () {
            const form = document.getElementById('reservationForm');
            const data = new FormData(form);

            fetch('@Url.Action("CreateReservation", "Student")', {
                method: 'POST',
                body: data
            })
            .then(r => r.json())
            .then(data => {
                const alert = document.getElementById('reservationAlert');
                if (data.success) {
                    alert.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                    form.reset();
                    loadMyReservations();
                    setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('reservationModal')).hide(), 1500);
                } else {
                    alert.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                }
            });
        });
    </script>
}